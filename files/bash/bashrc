[[ $- != *i* ]] && return

# Use devup's ssh-agent unit when the ssh_agent role installed it; otherwise keep
# the desktop's agent (e.g. GNOME's). Preserve forwarded agents in SSH sessions.
if [[ $OSTYPE == linux* && -n ${XDG_RUNTIME_DIR:-} && -z ${SSH_CONNECTION:-} \
      && -e $HOME/.config/systemd/user/ssh-agent.service ]]; then
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoredups:ignorespace
shopt -s histappend cmdhist checkwinsize
shopt -s autocd dirspell cdspell 2>/dev/null

alias cat=bat
alias grep='grep --color'
alias tree='tree -C'
alias ll='ls -l'
alias la='ls -la'
alias ..='cd ..'
alias ...='cd ../..'
alias g=git gs='git status' gd='git diff' ga='git add' gc='git commit' gp='git push' gl='git pull'

command -v mise >/dev/null && eval "$(mise activate bash)"
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
command -v direnv >/dev/null && eval "$(direnv hook bash)"
command -v starship >/dev/null && eval "$(starship init bash)"
