# History (set before oh-my-zsh, which only fills in values left unset)
HISTFILE="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# oh-my-zsh (cloned and pinned by the shell role). It also runs compinit,
# loads colors and sets up emacs keybindings (Ctrl+arrows, Home/End, ...).
export ZSH="$HOME/.local/share/oh-my-zsh"   # same path the shell role clones to
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
ZSH_THEME=""                         # starship draws the prompt
zstyle ':omz:update' mode disabled   # version is pinned by ansible
plugins=(
  git
  sudo
  docker
  kubectl
  rust
  golang
  python
  tmux
  colored-man-pages
  command-not-found
  history-substring-search
)
[[ -r $ZSH/oh-my-zsh.sh ]] && source "$ZSH/oh-my-zsh.sh"

# Aliases (after oh-my-zsh so these win over its defaults)
alias cat=bat
alias grep='grep --color'
alias egrep='egrep --color'
alias tree='tree -C'
alias ls='eza --group-directories-first --header --git --icons=auto'
alias ll='ls -l'
alias la='ls -la'
alias ..='cd ..'
alias ...='cd ../..'
alias vi=nvim vim=nvim vimdiff='nvim -d'
alias g=git gs='git status' gd='git diff' ga='git add' gc='git commit' gp='git push' gl='git pull'

# Plugins from the distro (Arch: /usr/share/zsh/plugins, Fedora: /usr/share,
# Homebrew: share)
_zsh_plugin() {
  local name=$1 p
  for p in "/usr/share/zsh/plugins/$name/$name.zsh" \
           "/usr/share/$name/$name.zsh" \
           "${HOMEBREW_PREFIX:-/opt/homebrew}/share/$name/$name.zsh" \
           "/usr/local/share/$name/$name.zsh"; do
    [[ -r $p ]] && { source "$p"; return; }
  done
}
_zsh_plugin zsh-autosuggestions
bindkey '^ ' autosuggest-accept
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^P' history-substring-search-up
bindkey '^N' history-substring-search-down

# fzf
if command -v fzf >/dev/null; then source <(fzf --zsh); fi

# Edit command line in editor
autoload -z edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# Tools
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"

# Syntax highlighting must be sourced last
_zsh_plugin zsh-syntax-highlighting

export PATH=$PATH:/usr/bin
